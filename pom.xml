<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
             http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.example</groupId>
    <artifactId>cdc-chcclp-rest-server</artifactId>
    <version>1.0-SNAPSHOT</version>
    <packaging>jar</packaging>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.2.5</version>
        <relativePath/>
    </parent>

    <properties>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencies>
        <!-- Spring Boot Web -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- Load .env file into Spring Environment -->
        <dependency>
            <groupId>me.paulschwarz</groupId>
            <artifactId>spring-dotenv</artifactId>
            <version>4.0.0</version>
        </dependency>

        <!-- Local CHCCLP / CDC libs -->
        <dependency><groupId>local</groupId><artifactId>Common</artifactId><version>1.0</version><scope>system</scope><systemPath>${project.basedir}/lib/Common.jar</systemPath></dependency>
        <dependency><groupId>local</groupId><artifactId>api</artifactId><version>1.0</version><scope>system</scope><systemPath>${project.basedir}/lib/api.jar</systemPath></dependency>
        <dependency><groupId>local</groupId><artifactId>chcclp</artifactId><version>1.0</version><scope>system</scope><systemPath>${project.basedir}/lib/chcclp.jar</systemPath></dependency>
        <dependency><groupId>local</groupId><artifactId>com.ibm.icu</artifactId><version>1.0</version><scope>system</scope><systemPath>${project.basedir}/lib/com.ibm.icu_4.4.2.v20110823.jar</systemPath></dependency>
        <dependency><groupId>local</groupId><artifactId>comms</artifactId><version>1.0</version><scope>system</scope><systemPath>${project.basedir}/lib/comms.jar</systemPath></dependency>
        <dependency><groupId>local</groupId><artifactId>db2cmn</artifactId><version>1.0</version><scope>system</scope><systemPath>${project.basedir}/lib/db2cmn.jar</systemPath></dependency>
        <dependency><groupId>local</groupId><artifactId>db2jcc</artifactId><version>1.0</version><scope>system</scope><systemPath>${project.basedir}/lib/db2jcc.jar</systemPath></dependency>
        <dependency><groupId>local</groupId><artifactId>db2jcc4</artifactId><version>1.0</version><scope>system</scope><systemPath>${project.basedir}/lib/db2jcc4.jar</systemPath></dependency>
        <dependency><groupId>local</groupId><artifactId>db2jcc_license_cisuz</artifactId><version>1.0</version><scope>system</scope><systemPath>${project.basedir}/lib/db2jcc_license_cisuz.jar</systemPath></dependency>
        <dependency><groupId>local</groupId><artifactId>db2jcc_license_cu</artifactId><version>1.0</version><scope>system</scope><systemPath>${project.basedir}/lib/db2jcc_license_cu.jar</systemPath></dependency>
        <dependency><groupId>local</groupId><artifactId>db2qreplapis</artifactId><version>1.0</version><scope>system</scope><systemPath>${project.basedir}/lib/db2qreplapis.jar</systemPath></dependency>
        <dependency><groupId>local</groupId><artifactId>db2replapis</artifactId><version>1.0</version><scope>system</scope><systemPath>${project.basedir}/lib/db2replapis.jar</systemPath></dependency>
        <dependency><groupId>local</groupId><artifactId>db2replmsgs</artifactId><version>1.0</version><scope>system</scope><systemPath>${project.basedir}/lib/db2replmsgs.jar</systemPath></dependency>
        <dependency><groupId>local</groupId><artifactId>ibmjzos</artifactId><version>1.0</version><scope>system</scope><systemPath>${project.basedir}/lib/ibmjzos.jar</systemPath></dependency>
        <dependency><groupId>local</groupId><artifactId>jms</artifactId><version>1.0</version><scope>system</scope><systemPath>${project.basedir}/lib/jms.jar</systemPath></dependency>
        <dependency><groupId>local</groupId><artifactId>messaging</artifactId><version>1.0</version><scope>system</scope><systemPath>${project.basedir}/lib/messaging.jar</systemPath></dependency>
        <dependency><groupId>local</groupId><artifactId>online</artifactId><version>1.0</version><scope>system</scope><systemPath>${project.basedir}/lib/online.jar</systemPath></dependency>
        <dependency><groupId>local</groupId><artifactId>eclipse.core.jobs</artifactId><version>1.0</version><scope>system</scope><systemPath>${project.basedir}/lib/org.eclipse.core.jobs_3.5.300.v20120912-155018.jar</systemPath></dependency>
        <dependency><groupId>local</groupId><artifactId>eclipse.core.runtime</artifactId><version>1.0</version><scope>system</scope><systemPath>${project.basedir}/lib/org.eclipse.core.runtime_3.8.0.v20120912-155025.jar</systemPath></dependency>
        <dependency><groupId>local</groupId><artifactId>eclipse.equinox.common</artifactId><version>1.0</version><scope>system</scope><systemPath>${project.basedir}/lib/org.eclipse.equinox.common_3.6.100.v20120522-1841.jar</systemPath></dependency>
        <dependency><groupId>local</groupId><artifactId>eclipse.osgi</artifactId><version>1.0</version><scope>system</scope><systemPath>${project.basedir}/lib/org.eclipse.osgi_3.8.2.v20130124-134944.jar</systemPath></dependency>
        <dependency><groupId>local</groupId><artifactId>eclipse.ui.workbench</artifactId><version>1.0</version><scope>system</scope><systemPath>${project.basedir}/lib/org.eclipse.ui.workbench_3.104.0.v20130204-164612.jar</systemPath></dependency>
        <dependency><groupId>local</groupId><artifactId>eclipse.ui</artifactId><version>1.0</version><scope>system</scope><systemPath>${project.basedir}/lib/org.eclipse.ui_3.104.0.v20121024-145224.jar</systemPath></dependency>
        <dependency><groupId>local</groupId><artifactId>resources</artifactId><version>1.0</version><scope>system</scope><systemPath>${project.basedir}/lib/resources.jar</systemPath></dependency>
        <dependency><groupId>local</groupId><artifactId>server</artifactId><version>1.0</version><scope>system</scope><systemPath>${project.basedir}/lib/server.jar</systemPath></dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Spring Boot fat-jar, includes system-scope libs -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <includeSystemScope>true</includeSystemScope>
                    <mainClass>com.ibm.cdc.chcclp.rest.ChcclpWebServiceApplication</mainClass>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
